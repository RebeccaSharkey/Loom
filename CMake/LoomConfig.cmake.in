@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
list(APPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}/third-party")

find_dependency(SDL3 CONFIG)

# Core is not optional.
include("${CMAKE_CURRENT_LIST_DIR}/LoomCoreTargets.cmake")
set(Loom_Core_FOUND TRUE)

# Optional modules.
foreach(_comp IN LISTS Loom_FIND_COMPONENTS)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/Loom${_comp}Targets.cmake")
        include("${CMAKE_CURRENT_LIST_DIR}/Loom${_comp}Targets.cmake")
        set(Loom_${_comp}_FOUND TRUE)
    else()
        set(Loom_${_comp}_FOUND FALSE)
    endif()
endforeach()

check_required_components(Loom)