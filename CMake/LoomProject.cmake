include_guard(GLOBAL)

function(loom_read_project DESCRIPTOR OUT_MODULES)
    get_filename_component(DESCRIPTOR "${DESCRIPTOR}" ABSOLUTE)
    if(NOT EXISTS "${DESCRIPTOR}")
        message(FATAL_ERROR "Loom: project descriptor not found: ${DESCRIPTOR}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${DESCRIPTOR}")
    file(READ "${DESCRIPTOR}" _json)
    string(JSON _type ERROR_VARIABLE _error TYPE "${_json}")
    if(_error OR NOT _type STREQUAL "OBJECT")
        message(FATAL_ERROR "Loom: ${DESCRIPTOR}: expected a JSON object: ${_error}")
    endif()
    foreach(_field FileVersion EngineVersion Name DisplayName ContentRoot Modules)
        string(JSON _type ERROR_VARIABLE _error TYPE "${_json}" "${_field}")
        if(_error)
            message(FATAL_ERROR "Loom: ${DESCRIPTOR}: missing field ${_field}")
        endif()
        if(_field STREQUAL "FileVersion")
            string(JSON _value GET "${_json}" "${_field}")
            if(NOT _type STREQUAL "NUMBER" OR NOT _value STREQUAL "1")
                message(FATAL_ERROR "Loom: ${DESCRIPTOR}: FileVersion must be 1")
            endif()
        elseif(_field STREQUAL "Modules")
            if(NOT _type STREQUAL "ARRAY")
                message(FATAL_ERROR "Loom: ${DESCRIPTOR}: Modules must be an array")
            endif()
        else()
            string(JSON _value GET "${_json}" "${_field}")
            if(NOT _type STREQUAL "STRING" OR _value STREQUAL "")
                message(FATAL_ERROR "Loom: ${DESCRIPTOR}: ${_field} must be a non-empty string")
            endif()
            set(_${_field} "${_value}")
        endif()
    endforeach()
    string(TOUPPER "${_Name}" _upper_name)
    if(NOT _Name MATCHES "^[A-Za-z][A-Za-z0-9_]*$" OR _upper_name MATCHES "^(CON|PRN|AUX|NUL|COM[0-9]|LPT[0-9])$")
        message(FATAL_ERROR "Loom: ${DESCRIPTOR}: Name must be a safe code identifier")
    endif()
    if(_upper_name MATCHES "^(ALL|ALL_BUILD|ZERO_CHECK|RUN_TESTS|PACKAGE|INSTALL|CLEAN|TEST|HELP|EDIT_CACHE|REBUILD_CACHE)$")
        message(FATAL_ERROR "Loom: ${DESCRIPTOR}: Name is a reserved CMake target")
    endif()
    if(NOT _EngineVersion MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
        message(FATAL_ERROR "Loom: ${DESCRIPTOR}: EngineVersion must be major.minor.patch")
    endif()
    if(_DisplayName MATCHES "[;\n\r]" OR _ContentRoot MATCHES "[;\n\r]")
        message(FATAL_ERROR "Loom: ${DESCRIPTOR}: DisplayName/ContentRoot cannot contain semicolons or newlines")
    endif()
    if(IS_ABSOLUTE "${_ContentRoot}" OR _ContentRoot MATCHES "(^|/)\\.\\.(/|$)" OR _ContentRoot MATCHES "[:\\\\]")
        message(FATAL_ERROR "Loom: ${DESCRIPTOR}: ContentRoot must be project-relative, using forward slashes, without '..'")
    endif()
    set(_modules "")
    string(JSON _count LENGTH "${_json}" Modules)
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_i RANGE ${_last})
            string(JSON _type TYPE "${_json}" Modules ${_i})
            string(JSON _mod GET "${_json}" Modules ${_i})
            if(NOT _type STREQUAL "STRING" OR NOT _mod STREQUAL "Render2D")
                message(FATAL_ERROR "Loom: ${DESCRIPTOR}: Modules[${_i}]: unknown module '${_mod}'; supported: Render2D (Core is implicit)")
            endif()
            if(_mod IN_LIST _modules)
                message(FATAL_ERROR "Loom: ${DESCRIPTOR}: Modules: duplicate '${_mod}'")
            endif()
            list(APPEND _modules "${_mod}")
        endforeach()
    endif()
    get_filename_component(_root "${DESCRIPTOR}" DIRECTORY)
    set(${OUT_MODULES} "${_modules}" PARENT_SCOPE)
    foreach(_field Name DisplayName EngineVersion ContentRoot)
        set(LOOM_PROJECT_${_field} "${_${_field}}" PARENT_SCOPE)
    endforeach()
    set(LOOM_PROJECT_DIRECTORY "${_root}" PARENT_SCOPE)
endfunction()

function(loom_configure_target TARGET)
    target_link_libraries(${TARGET} PRIVATE Loom::Core)
    foreach(_mod IN LISTS LOOM_MODULES)
        target_link_libraries(${TARGET} PRIVATE Loom::${_mod})
    endforeach()
    foreach(_field Name DisplayName ContentRoot)
        set(_${_field} "${LOOM_PROJECT_${_field}}")
        string(REPLACE "\\" "\\\\" _${_field} "${_${_field}}")
        string(REPLACE "\"" "\\\"" _${_field} "${_${_field}}")
    endforeach()
    set(_content "${LOOM_PROJECT_DIRECTORY}/${LOOM_PROJECT_ContentRoot}")
    if(NOT IS_DIRECTORY "${_content}")
        message(FATAL_ERROR "Loom: ContentRoot directory does not exist: ${_content}")
    endif()
    string(REPLACE "\\" "/" _content "${_content}")
    string(REPLACE "\"" "\\\"" _escaped_content "${_content}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/LoomProjectConfig.h"
        "#pragma once\n#include <Core/Application.h>\nnamespace LoomProject {\ninline Loom::ApplicationSpecification Specification() {\n Loom::ApplicationSpecification spec{\"${_Name}\", Loom::WindowSpecification(\"${_DisplayName}\",1280,720,false)};\n spec.DevelopmentContentRoot = \"${_escaped_content}\";\n spec.PackagedContentRoot = \"${_ContentRoot}\";\n return spec;\n}\n}\n")
    target_include_directories(${TARGET} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
    add_custom_target(${TARGET}Content ALL
        COMMAND ${CMAKE_COMMAND} -E copy_directory "${_content}" "$<TARGET_FILE_DIR:${TARGET}>/${LOOM_PROJECT_ContentRoot}"
        VERBATIM)
    add_dependencies(${TARGET} ${TARGET}Content)
    set_property(TARGET ${TARGET} PROPERTY VS_DEBUGGER_WORKING_DIRECTORY "$<TARGET_FILE_DIR:${TARGET}>")
endfunction()
