{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25
  },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "Visual Studio (x64)",
      "description": "Finds the engine through the LOOM_ROOT environment variable. No pinned generator, so the consumer is always built with the same toolset as the engine it links.",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/Generated/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{LOOM_ROOT}"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug",   "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "msvc-release", "configurePreset": "msvc", "configuration": "Release" }
  ]
}
