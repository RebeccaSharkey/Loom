# Normalise line endings: LF in the repository, native in the working tree.
* text=auto

# --- Source ---
*.cpp   text diff=cpp
*.h     text diff=cpp
*.hpp   text diff=cpp
*.inl   text diff=cpp

# --- Build & config ---
*.txt       text
*.cmake     text
*.json      text
*.yml       text
*.yaml      text
.gitignore  text
.gitattributes text

# --- Docs ---
*.md    text diff=markdown
LICENSE text

# --- Scripts: ---
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf
*.py    text diff=python

# --- Binary: ---
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.wav   binary
*.ogg   binary
*.dll   binary
*.lib   binary
*.exe   binary
*.pdb   binary
