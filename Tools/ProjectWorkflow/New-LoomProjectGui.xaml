<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loom - New Project" Width="840" Height="760" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#212121" Foreground="#ECECEC" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#A6A6A6"/>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="BorderBrush" Value="#474747"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F4F4F4"/>
            <Setter Property="Foreground" Value="#171717"/>
            <Setter Property="BorderBrush" Value="#F4F4F4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#555555"/>
            <Setter Property="BorderBrush" Value="#424242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A6A6A6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="19" Height="19" CornerRadius="5" BorderBrush="#777777" BorderThickness="1" Background="#212121" VerticalAlignment="Center">
                                <Path x:Name="Tick" Visibility="Collapsed" Data="M 3,8 L 7,12 L 14,4" Stroke="#171717" StrokeThickness="2"/>
                            </Border>
                            <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#ECECEC"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#A6A6A6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#424242"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A6A6A6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="BorderBrush" Value="#474747"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#ECECEC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Surface" Background="#2F2F2F" CornerRadius="5" Padding="14,8">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#424242"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb"><Border Background="#555555" CornerRadius="4" Margin="1"/></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB4AB"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="2,5,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>
    <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid x:Name="TitleBar" Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,8,3">
                    <Button x:Name="MinimizeButton" Content="&#x2014;" Width="38" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                    <Button x:Name="MaximizeButton" Content="&#x25A1;" Width="38" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Maximize" AutomationProperties.Name="Maximize"/>
                    <Button x:Name="CloseButton" Content="&#x2715;" Width="38" Padding="0" Background="Transparent" BorderThickness="0" ToolTip="Close" AutomationProperties.Name="Close"/>
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="FormViewport" Grid.Row="1" Padding="30,10,30,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <Grid MinHeight="{Binding ViewportHeight, ElementName=FormViewport}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,19">
                    <TextBlock Text="Create a new project" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Your next game starts here." Foreground="{StaticResource Muted}" Margin="0,8,0,0" FontSize="13"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,0,0,17">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Project identifier" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameInput" Text="MyGame" AutomationProperties.Name="Project identifier" TabIndex="0"/>
                        <TextBlock x:Name="NameError" Style="{StaticResource FieldError}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Display name" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DisplayNameInput" Text="My Game" AutomationProperties.Name="Display name" TabIndex="1"/>
                        <TextBlock x:Name="DisplayNameError" Style="{StaticResource FieldError}"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Project folder" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="DestinationInput" AutomationProperties.Name="Final project folder" TabIndex="2"/>
                        <Button x:Name="BrowseDestinationButton" Grid.Column="2" Content="Browse" Padding="0" TabIndex="3"/>
                    </Grid>
                    <TextBlock x:Name="DestinationError" Style="{StaticResource FieldError}"/>
                    <TextBlock Text="Choose a parent folder. A new project folder will be created inside it." FontSize="11" Foreground="#8C8C8C" Margin="2,7,0,17"/>
                    <TextBlock Text="Engine installation" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="EngineInput" AutomationProperties.Name="Engine installation" TabIndex="4"/>
                        <Button x:Name="BrowseEngineButton" Grid.Column="2" Content="Browse" Padding="0" TabIndex="5"/>
                    </Grid>
                    <TextBlock x:Name="EngineError" Style="{StaticResource FieldError}"/>
                    <Border Background="#282828" BorderBrush="#393939" BorderThickness="1" CornerRadius="11" Padding="16,13" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox x:Name="Render2DInput" Content="Render2D" TabIndex="6"/>
                                <TextBlock Text="Optional module stub. Core is always included." Foreground="{StaticResource Muted}" FontSize="11" Margin="30,5,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="6" Background="#353535" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="OPTIONAL" FontSize="9" Foreground="#BABABA"/></Border>
                        </Grid>
                    </Border>
                </StackPanel>
                <Grid Grid.Row="3" Margin="0,21,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Ready when you are." Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,18,0" FontSize="12"/>
                    <Button x:Name="CreateButton" Grid.Column="1" Content="Create project  &#x2192;" Style="{StaticResource Primary}" Padding="20,12" TabIndex="7"/>
                </Grid>
                <Grid Grid.Row="4" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PROJECT" FontSize="10" Foreground="#919191" VerticalAlignment="Center" Margin="0,0,13,0"/>
                        <Border CornerRadius="9" Background="#171717" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DebugOption" Content="Debug" GroupName="Configuration" IsChecked="True" TabIndex="8"/>
                                <RadioButton x:Name="ReleaseOption" Content="Release" GroupName="Configuration" TabIndex="9"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BuildButton" Content="Build" IsEnabled="False" Padding="13,8" Margin="0,0,7,0" TabIndex="10"/>
                        <Button x:Name="RunButton" Content="Run" IsEnabled="False" Padding="13,8" Margin="0,0,7,0" TabIndex="11"/>
                        <Button x:Name="OpenButton" Content="Open folder" IsEnabled="False" Padding="13,8" TabIndex="12"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="5" Background="#191919" CornerRadius="11" BorderBrush="#363636" BorderThickness="1" MinHeight="115">
                    <Grid Margin="16,12,12,12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="OUTPUT" FontSize="10" Foreground="#919191" Margin="0,0,0,10"/>
                        <TextBox x:Name="OutputText" Grid.Row="1" Text="Project details and build output will appear here." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="0" Foreground="#A6A6A6" FontFamily="Consolas" FontSize="11" TabIndex="13" AutomationProperties.Name="Project output"/>
                    </Grid>
                </Border>
            </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="#1B1B1B" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="30,9">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Loom Engine" FontSize="11" Foreground="#A6A6A6"/>
                    <TextBlock x:Name="EngineVersionText" FontSize="11" Foreground="#858585" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
    </Grid>
</Window>
